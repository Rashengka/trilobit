#
# Configuration shared by every environment.
#
# What differs between two deployments of the same code belongs in .env, and
# what differs on one developer's machine belongs in config/local.neon; see
# config/local.neon.example. Neither of those is in the repository.
#

parameters:
    # Overwritten by the boot with whatever config/modules.neon declares. The
    # empty default is here so that this file describes a complete
    # configuration on its own, and because a build with no optional module is
    # a build the application has to support.
    modules: []

    # The design system; see .ai/plans/01d-design-system.md.
    trilobit:
        # Which set of token values the pages start in. It has to name a file
        # in assets/themes/, and a deployment that wants another one overrides
        # this from config/local.neon - what the site looks like is not a code
        # change. A visitor can switch it in the browser afterwards without a
        # request, because the whole of a theme is one attribute on <html>.
        theme: atrium

        # Whether this build has a style guide at /_styleguide.
        #
        # On while developing and off in production, where it would be a page
        # with nothing behind it. Off means the route is never registered, so
        # the path is claimed by nobody and the answer is 404 rather than 403:
        # a tool that is not here has nothing to admit to.
        styleguide: %debugMode%

extensions:
    core: Trilobit\Core\DI\CoreExtension

    # Registers nothing outside the command line, so the web container is
    # unchanged by its presence. The console is where the generated files under
    # var/ are written from, and where the schema tools live.
    console: Contributte\Console\DI\ConsoleExtension(%consoleMode%)

    # The bridge between Nette and Doctrine is taken ready-made rather than
    # written, because the three configuration keys the modular schema stands on
    # - a mapping per namespace, a migrations directory per namespace, and a
    # filter over the tables the schema tools may see - are exactly the keys it
    # already has. It is pinned to a 0.x minor on purpose: before 1.0 a minor
    # release may break, and the caret refuses to cross one.
    nettrine.dbal: Nettrine\DBAL\DI\DbalExtension
    nettrine.orm: Nettrine\ORM\DI\OrmExtension
    nettrine.migrations: Nettrine\Migrations\DI\MigrationsExtension

    # "assets" is not listed here: Nette\Bootstrap\Configurator already
    # registers it, wired to %baseUrl% (autodetected from the request),
    # %wwwDir% and %debugMode% - which is also what makes ViteMapper look for
    # a running dev server only outside production. Registering it again under
    # the same name is a compile error ("already used or reserved"); the
    # "assets:" section below only configures the one it already added.

console:
    name: Trilobit

application:
    # Presenter names are mapped explicitly rather than by convention, because
    # the convention has changed between framework versions and because an
    # explicit map is what lets a module bring its own mapping with it: an
    # enabled module adds one line from its own configuration file, a disabled
    # one adds nothing, and a link into it then fails loudly instead of
    # resolving to a blank page.
    #
    #   Core:Front:Home  ->  Trilobit\Core\Presentation\Front\HomePresenter
    mapping:
        Core: Trilobit\Core\Presentation\*\*Presenter

    errorPresenter: Nette:Error
    catchExceptions: false

latte:
    strictTypes: true
    strictParsing: true

http:
    frames: SAMEORIGIN

session:
    autoStart: smart
    expiration: 14 days

tracy:
    showBar: %debugMode%

#
# Front-end assets, built by Vite. See .ai/plans/01b-frontend.md.
#
# The mapper is registered under the scope "vite" rather than "default", so
# that {asset 'vite:assets/app.ts'} in a template names the mapper it is
# using, not a magic prefix ViteMapper reserves for itself - Nette\Assets\
# Registry parses everything before the colon as a mapper id, whichever one
# is registered there.
#
assets:
    mapping:
        vite:
            type: vite

            # Resolved against the default basePath, %wwwDir%, and matches
            # vite.config.ts's own build.outDir - where the manifest
            # `npm run build` writes lives: www/build/.vite/manifest.json.
            path: build

#
# The database.
#
# Every setting names its fallback on the same line, so that a checkout with no
# .env still compiles a container and fails only when something actually asks
# for a connection. The alternative - a parameter that has to resolve - turns
# one missing line in .env into an application that cannot start at all.
#
nettrine.dbal:
    debug:
        panel: %debugMode%

    connections:
        default:
            driver: pdo_mysql
            host: @core.environment::value(TRILOBIT_DB_HOST, 127.0.0.1)
            port: @core.environment::value(TRILOBIT_DB_PORT, '13306')
            dbname: @core.environment::value(TRILOBIT_DB_NAME, trilobit)
            user: @core.environment::value(TRILOBIT_DB_USER, trilobit)
            password: @core.environment::value(TRILOBIT_DB_PASSWORD)
            charset: utf8mb4

            # Declared rather than asked for. Without it Doctrine opens a
            # connection merely to find out which platform it is talking to,
            # which would make reading the mapping - what the architecture
            # tests do - impossible on a machine with no database running.
            # MariaDB 11 LTS is the only tested target; a deployment on another
            # one says so in config/local.neon.
            serverVersion: @core.environment::value(TRILOBIT_DB_SERVER_VERSION, 11.8.0-MariaDB)

            # The tables this build is allowed to see. It is the whole of what
            # protects a switched-off module's data: without it the schema
            # comparator sees tables with nothing in the mapping to justify
            # them, and writes a migration that drops them. See
            # Trilobit\Core\Doctrine\SchemaAssetsFilter.
            schemaAssetsFilter: @core.schemaAssetsFilter

nettrine.orm:
    managers:
        default:
            connection: default

            # Proxies are PHP's own lazy objects rather than generated
            # classes. The project is on PHP 8.4 anyway, Doctrine deprecates
            # every other answer, and the alternative is a package pulled in
            # for nothing but this.
            lazyNativeObjects: true

            # Core maps its own entities and nothing else. A module adds its
            # own three lines from its own configuration file, which the boot
            # loads only when the module is switched on - so a build without a
            # module has no metadata for its entities, no repositories and no
            # proxies, rather than a mapping that is merely unused.
            mapping:
                Core:
                    directories: [%rootDir%/src/Core/Domain]
                    namespace: Trilobit\Core\Domain

nettrine.migrations:
    # The table the migrations record themselves in carries a module prefix
    # like every other table, because the filter above decides what exists by
    # reading prefixes: a table it hides is a table Doctrine believes is not
    # there, and the migrations would try to create it on every run.
    table: core_migration

    # One namespace per module, which is how doctrine/migrations natively holds
    # more than one directory. An enabled module contributes its line, a
    # disabled one contributes nothing, and the shared record of what has been
    # executed holds full class names - so switching a module back on runs the
    # versions it is missing and nothing else.
    directories:
        'Trilobit\Core\Migrations': %rootDir%/src/Core/Migrations
