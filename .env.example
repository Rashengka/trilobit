# Template for the environment file. Copy it to .env and fill it in:
#
#   cp .env.example .env
#
# .env is in .gitignore. Every value below is deliberately empty: a committed
# file that carries a real host, user or password is a disclosure that git
# keeps forever, so the committed file carries the shape and nothing else.

# Turns the debug bar and the detailed error page on. Any value but an empty
# one counts as on. It is a variable rather than an IP address check, because
# an address check is unreliable in production and would mean an address
# written down in the repository.
TRILOBIT_DEBUG=

# Database connection. The tested target is MariaDB 11 LTS and nothing else;
# `docker compose up -d` starts one, reading these same values, so the two
# cannot drift apart. Anything left empty falls back to what config/common.neon
# names beside it - which is enough for the container in compose.yaml, and not
# enough for anywhere else.
TRILOBIT_DB_HOST=
TRILOBIT_DB_PORT=
TRILOBIT_DB_NAME=
TRILOBIT_DB_USER=
TRILOBIT_DB_PASSWORD=

# Which server the schema is generated for. Doctrine would otherwise open a
# connection just to find out, which is why it is declared rather than asked
# for: the architecture suite reads the mapping on machines with no database
# running. Leave it empty unless the server is not the one compose.yaml starts.
TRILOBIT_DB_SERVER_VERSION=
