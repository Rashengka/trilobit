require __DIR__ . '/../vendor/autoload.php';

// A PHP namespace literal is not a UNC path. The rule used to match the
// doubled backslashes below and made ordinary code have to be written the
// long way round, so the branch that did it was removed.
$extension = $namespace . '\\DI\\' . $label . 'Extension';
$class = 'Trilobit\\Shop\\DI\\ShopExtension';

// Prose is not a path either. A drive letter and a separator followed by a
// space used to be reported as one, which is how a commit message describing
// the rule came to fail the check.
// Writing C:\ in a sentence like this one has to stay clean.
