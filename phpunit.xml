<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         cacheDirectory=".phpunit.cache"
         colors="true"
         beStrictAboutOutputDuringTests="true"
         failOnDeprecation="true"
         failOnNotice="true"
         failOnRisky="true"
         failOnWarning="true"
         displayDetailsOnTestsThatTriggerDeprecations="true"
         displayDetailsOnTestsThatTriggerErrors="true"
         displayDetailsOnTestsThatTriggerNotices="true"
         displayDetailsOnTestsThatTriggerWarnings="true">
    <testsuites>
        <!--
            Every level from the test strategy has a suite here, empty ones
            included. A suite that appears only once it has a test in it is a
            suite nobody notices is missing.
        -->
        <testsuite name="unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="architecture">
            <directory>tests/Architecture</directory>
        </testsuite>
        <testsuite name="template">
            <directory>tests/Template</directory>
        </testsuite>
        <testsuite name="integration">
            <directory>tests/Integration</directory>
        </testsuite>
        <testsuite name="combination">
            <directory>tests/Combination</directory>
        </testsuite>
        <testsuite name="install">
            <directory>tests/Install</directory>
        </testsuite>
        <testsuite name="tooling">
            <directory>tests/Tooling</directory>
            <!--
                CheckLeaksTest.php is a standalone script that ends in exit();
                loading it as a test case would end the run. LeakGuardTest runs
                it as a child process instead.
            -->
            <exclude>tests/Tooling/CheckLeaksTest.php</exclude>
        </testsuite>
    </testsuites>
    <!--
        Things the runner does on its own, so that no test has to remember
        them: a finished test hands its database connections back, a run that
        stops without finishing says why, a unit test is turned away from the
        database, and the whole run says what it cost. All four are
        silent-failure guards and all four are described in the classes
        themselves.
    -->
    <extensions>
        <bootstrap class="Trilobit\Tests\Runner\ClosingConnections"/>
        <bootstrap class="Trilobit\Tests\Runner\SayingWhyTheRunStopped"/>
        <bootstrap class="Trilobit\Tests\Runner\KeepingUnitTestsAwayFromTheDatabase"/>
        <bootstrap class="Trilobit\Tests\Runner\WhatTheWholeRunCost">
            <!--
                What the whole run may cost, in processor seconds. Why it is
                processor seconds and not wall clock is argued in the class;
                where this particular number came from is here, because this is
                where somebody tempted to raise it will be standing.

                Measured over this tree on a fourteen core machine, 835 tests:
                58.2 s and 63.7 s of processor time on a quiet machine, against
                237 s and 335 s on the clock. The same suite against sixteen
                processes deliberately spinning: 130.8 s of processor time and
                697 s on the clock. So the worst figure a healthy suite has
                actually produced here is about 131 s.

                300 is a little over twice that, and the headroom is bought for
                one machine that could not be measured from here: CI runs the
                same suite on a hosted runner whose cores are slower, and the
                same work on a slower core is more processor seconds, not fewer.
                It is deliberately loose rather than advisory - a budget that
                fires late and stops the run is worth more than one that fires
                early and only prints. At the growth this suite has shown, 709
                to 824 tests in a week, it is a number the suite would reach in
                months rather than years, which is the point: reaching it is
                what buys running the combinations in parallel.

                Exit condition: tighten it once CI has printed its own figures
                for a few weeks and there is a measured number for the machine
                this headroom was bought for. Every run prints its cost, so
                those figures now exist to be read.
            -->
            <parameter name="processorSecondsBudget" value="300"/>
        </bootstrap>
    </extensions>
    <php>
        <!--
            The suite's own headroom, named here rather than left to whatever
            php.ini the machine has, exactly as composer.json names one for
            static analysis. It peaked at 126.5 MB against the 128M a stock
            PHP image gives, which is not a limit with room in it but a limit
            about to be crossed - and crossing it kills the process mid-run.

            It is in this file rather than in the composer script so that a run
            started from an editor gets it too: a limit only `composer test`
            knows about is a limit half the runs do not have.
        -->
        <ini name="memory_limit" value="512M"/>
    </php>
    <source>
        <include>
            <directory>src</directory>
        </include>
    </source>
</phpunit>
