/.env
/config/local.neon
/node_modules/
/var/
/vendor/
/www/build/

# Browser-suite output.
/test-results/
/playwright-report/
/.playwright/

# Tool caches.
/.deptrac.cache
/.php-cs-fixer.cache
/.phpunit.cache/

# Editor and OS state. None of it belongs to the project, and an IDE directory
# in particular carries local paths and configured data sources, which is
# exactly the kind of thing this repository must not publish.
/.idea/
/.vscode/
/.fleet/
/.zed/
*.iml
.DS_Store

# Local development stack. compose.yaml is the tracked one; this is the layer
# Compose merges on top of it on this machine only.
/compose.override.yaml
/compose.override.yml
/docker-compose.override.yaml
/docker-compose.override.yml
