{**
 * c-signpost - the way into each part of something, drawn as a grid of linked
 * tiles built out of c-card.
 *
 * It exists because the same shape answers two different questions - the
 * homepage's "where does a visitor go in" and an administration section's
 * "what does this section hold" - and both are assembled from data rather
 * than written into a template by hand: the front page reads
 * Trilobit\Core\Presentation\Front\Signpost\SignpostList, an administration
 * section reads Trilobit\Core\Admin\Menu\Menu::itemsOf(). One component for
 * both keeps the two ways in from drawing the same idea two different ways.
 *
 * The one class on the element is the whole of its layout: assets/base.css
 * draws .c-signpost with the same rule as the grid primitive .l-grid rather
 * than beside it. Adding a second layout class here would put two rules of
 * equal weight on one element and leave the order of the stylesheet to settle
 * which applies, which is exactly how this component once cancelled its own
 * grid.
 *
 * @param iterable<Trilobit\Core\Presentation\Component\SignpostLink> $items
 *}

{import 'card.latte'}

{define signpost, iterable $items, string $label, ?string $testId = null}
    <nav class="c-signpost" aria-label="{$label}" data-testid="{$testId}">
        {foreach $items as $item}
            {include card,
                title: $item->label,
                href: $item->href,
                text: $item->summary,
                media: ($item->label|slice: 0, 1),
                testId: $item->testId}
        {/foreach}
    </nav>
{/define}
