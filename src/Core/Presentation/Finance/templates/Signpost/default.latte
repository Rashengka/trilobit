{templateType Trilobit\Core\Presentation\Finance\SignpostTemplate}

{*
 * The signpost of a business's money matters.
 *
 * The tiles are exactly the entries Core contributed to the administration
 * bar for this section, filtered the way the bar is - one data structure, two
 * renderings - so there is no list written by hand here. See
 * Trilobit\Core\Presentation\Finance\SignpostPresenter.
 *}

{import '../../../components/page-heading.latte'}
{import '../../../components/signpost.latte'}

{block content}
    {include pageHeading,
        title: $headline,
        lead: $lead,
        testId: 'finance-headline',
        leadTestId: 'finance-lead'}

    {include signpost, items: $items, label: 'Finance', testId: 'finance-signpost'}
{/block}
