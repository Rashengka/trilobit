{templateType Trilobit\Core\Presentation\Form\ArrangementTemplate}

{*
 * What the arrangements of a generated form are drawn out of: the reasons said
 * about the whole form, one field, and the row of buttons. It declares the type
 * of the templates that import it, the way the style guide's furniture does,
 * because it is only ever drawn as part of one of them.
 *
 * A field is c-field, the component a form written out by hand draws its
 * fields with, so the markup of one label and one control is written once for
 * both kinds of form (.ai/plans/19, variant C). What goes into its slots are
 * the framework's own elements, handed over by
 * Trilobit\Core\Presentation\Form\FormField already joined to their reasons
 * and their hint; nothing here writes an id or an aria attribute of its own
 * but the one naming a set of choices.
 *
 * An arrangement decides where these go and nothing about what is in them, so
 * that the three arrangements cannot say different things about one form
 * (tests/Template/FormArrangementsDifferOnlyInTheirWrappingTest).
 *}

{import '../../components/field.latte'}
{import '../../components/notice.latte'}

{* What was said about the form as a whole: above the fields, across every column of the arrangement. *}
{define formErrors, array $errors}
    <div class="l-form__errors" n:if="$errors !== []">
        {foreach $errors as $error}
            {include notice, message: $error, variant: 'danger'}
        {/foreach}
    </div>
{/define}

{*
 * What a required field's mark means, said once above the fields rather than
 * on each of them - c-field itself never says it, because it is one field and
 * the sentence is about the form. Drawn only where $shown says the mark is
 * somewhere on the page for it to explain: ArrangementTemplate::$requiredNoteShown
 * is false where no field is both required and labelled, or where the labels
 * are out of sight and the marks are hidden along with them.
 *}
{define formRequiredNote, bool $shown}
    <p class="c-field-required-note" n:if="$shown">Fields marked with * are required.</p>
{/define}

{* One field: a control of its own, or a row of them. What an arrangement draws for every entry of $fields. *}
{define formField, Trilobit\Core\Presentation\Form\FormField|Trilobit\Core\Presentation\Form\FormRow $field, bool $labelHidden = false}
    {if $field instanceof Trilobit\Core\Presentation\Form\FormRow}
        {include formRow, row: $field, labelHidden: $labelHidden}
    {else}
        {include formSingleField, field: $field, labelHidden: $labelHidden}
    {/if}
{/define}

{*
 * A row: one field whose label is its first control's, and whose control is
 * every control of the row side by side (l-form__row) - each a field of its
 * own, so that what is said about one is drawn under it and joined to it
 * rather than gathered under the whole row, where it would not say which
 * control it is about. The label is marked where any control in the row is
 * required (FormRow::isRequired()), and hidden with the others where the
 * arrangement hides every label.
 *}
{define formRow, Trilobit\Core\Presentation\Form\FormRow $row, bool $labelHidden = false}
    {embed block field,
        labelHidden: $labelHidden,
        required: $row->label() !== null && $row->isRequired()}
        {block fieldLabel}{$row->label()}{/block}

        {block fieldControl}
            <div class="l-form__row">
                {foreach $row->fields as $member}
                    {include formSingleField, field: $member, firstInRow: $iterator->first}
                {/foreach}
            </div>
        {/block}
    {/embed}
{/define}

{*
 * One control as a field. A set of choices is a group named by its label,
 * with each choice inside its own label, the way the Checks page of the style
 * guide draws one by hand.
 *
 * In a row ($firstInRow is not null) the first control's label is the row's
 * and formRow draws it, so the first draws no label here; every other one
 * draws its own out of sight - still naming its control - and without a mark,
 * which nobody would see. The empty slot is out of sight as well, so that no
 * control of the row starts lower than another.
 *}
{define formSingleField, Trilobit\Core\Presentation\Form\FormField $field, bool $labelHidden = false, ?bool $firstInRow = null}
    {embed block field,
        errorId: $field->errorId(),
        hintId: $field->hintId(),
        labelHidden: $labelHidden || $firstInRow !== null,
        required: $firstInRow === null && $field->label() !== null && $field->isRequired()}
        {block fieldLabel}{if $firstInRow !== true}{$field->label()}{/if}{/block}

        {block fieldControl}
            {if $field->kind === 'radios' || $field->kind === 'checks'}
                <div class="l-cluster" role="{$field->kind === 'radios' ? 'radiogroup' : 'group'}" aria-labelledby="{$field->labelId()}">
                    {foreach $field->choices() as $choice}
                        {$choice}
                    {/foreach}
                </div>
            {else}
                {$field->control()}
            {/if}
        {/block}

        {block fieldError}{foreach $field->errors() as $error}{$error}{sep} {/sep}{/foreach}{/block}

        {block fieldHint}{$field->hint()}{/block}
    {/embed}
{/define}

{*
 * The buttons, in a row of their own under the fields. Each is the element the
 * framework drew, carrying the design system's button - a submit control has
 * to be the form's own element, so c-button cannot draw one of its own.
 *}
{define formButtons, array $buttons}
    <div class="l-form__buttons" n:if="$buttons !== []">
        {foreach $buttons as $button}
            {$button->control()->class('c-button', true)}
        {/foreach}
    </div>
{/define}
