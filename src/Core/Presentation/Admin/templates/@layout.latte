{templateType Trilobit\Core\Presentation\Admin\AdminTemplate}

{*
 * The chrome every administration page is drawn in.
 *
 * It is the same shell, the same components and the same tokens as the public
 * side (src/Core/Presentation/Front/templates/@layout.latte). That is the point
 * of a design system: the administration is not a second application with a
 * look of its own to keep in step, it is the same one with different content in
 * it - so a theme moves the navigation here exactly as it moves it there, and a
 * component fixed in one place is fixed in both.
 *
 * The menu begins with the way back to where their administration begins and
 * goes on with the sections: what the enabled modules contributed and Core's
 * own way into the installation's section. All of it, the way back included,
 * is less whatever would refuse the person reading it - see
 * Trilobit\Core\Admin\Menu\ReachableMenu - so somebody whose role is one
 * section is drawn no way back at all, because the page it leads to is not
 * theirs to open. The mark in the banner leads to the same place, the same way
 * the mark in the public banner leads to the front page.
 *}

{import '../../components/site-header.latte'}
{import '../../components/user-menu.latte'}
{import '../../components/preference-switcher.latte'}
{import '../../components/nav.latte'}
{import '../../components/site-footer.latte'}
{import '../../components/toast.latte'}

<!DOCTYPE html>
<html lang="en" n:attr="$preferences->attributes()">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    <title>{ifset $pageTitle}{$pageTitle} | {/ifset}{$siteName} administration</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <link rel="icon" type="image/vnd.microsoft.icon" href="/favicon.ico" sizes="16x16 32x32">
</head>
<body class="l-shell" data-testid="admin-layout" data-preference-url="{$preferenceUrl}">

<header class="l-shell__banner" data-testid="admin-header">
    {embed block siteHeader,
        brand: $siteName,
        href: $overviewUrl,
        tagline: 'Administration',
        testId: 'admin-home-link'}
        {block siteHeaderEnd}
            {* Whoever is signed in, and everything that is theirs rather than
               the page's: who they are, the switch, the public site and the
               way out. The sign-in page has nobody yet, so it has no menu. *}
            {if $signedIn}
                {embed block userMenu,
                    id: 'admin-account-menu-panel',
                    name: $identityName,
                    email: $identityEmail,
                    signOutUrl: $signOutUrl,
                    publicSiteUrl: $publicSiteUrl,
                    testIdPrefix: 'admin'}
                    {block userMenuBody}
                        {include preferenceSwitcher, preferences: $preferences}
                    {/block}
                {/embed}
            {/if}
        {/block}
    {/embed}
</header>

{* Absent rather than empty while nobody is signed in: there is nothing to
   navigate to before there is somebody navigating. *}
<div class="l-shell__nav" n:if="$menu !== []">
    <div class="l-shell__nav-hold">
        {include nav, items: $menu, label: 'Administration', testId: 'admin-menu'}
    </div>
</div>

<main class="l-shell__main" data-testid="admin-content">
    <div class="l-container l-stack l-stack--loose">
        {include content}
    </div>

    {* The flash messages, as toasts in a corner of the window, in the snippet
       an answer to Naja puts them into - as in the public layout, and for the
       same reasons. *}
    <div n:snippet="flashes">{include toast, messages: $flashes, corner: true, testId: 'toasts'}</div>
</main>

<div class="l-shell__footer" data-testid="admin-footer">
    {embed block siteFooter}
        {block siteFooterBody}<p>{$siteName} &mdash; administration.</p>{/block}
    {/embed}
</div>

{* The same bundle the public side loads: Naja, the theme switch, and whatever
   every page needs whichever module it belongs to. *}
{block scripts}
    {asset 'vite:assets/app.ts'}
{/block}

</body>
</html>
