{templateType Trilobit\Core\Presentation\Front\HomeDefaultTemplate}

{*
 * The front page: what this is, what it stands on, and the way into every part
 * of it this build has.
 *
 * Every visible thing here is a component from src/Core/Presentation/components/
 * (decision D3). The page itself only decides which components appear and in
 * what order, and reaches for a layout primitive - l-grid - to arrange them. It
 * makes no decision about how any of them looks, which is what leaves that
 * decision to the theme.
 *}

{import '../../../components/page-heading.latte'}
{import '../../../components/marker-list.latte'}
{import '../../../components/signpost.latte'}

{block content}
    {include pageHeading,
        title: $headline,
        lead: $tagline,
        testId: 'homepage-headline',
        leadTestId: 'homepage-tagline'}

    {include markerList, items: $highlights, testId: 'homepage-highlights'}

    {if $signposts !== []}
        {include signpost, items: $signposts, label: 'Sections', testId: 'homepage-signposts'}
    {/if}
{/block}
