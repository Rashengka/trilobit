{templateType Trilobit\Core\Presentation\Styleguide\OverviewDefaultTemplate}

{*
 * The style guide, drawn with the components it is a guide to.
 *
 * Everything below the theme switcher is an {include} of a file in
 * src/Core/Presentation/components/ - the same files the homepage and the
 * modules include. Nothing here reproduces a component's markup, because a
 * catalogue that reproduced it would go on showing the old shape after the
 * component changed and nobody would know.
 *
 * The page has two catalogues, because the design system has two halves. The
 * components are things somebody assembles, and they are checked by
 * tests/Template/StyleguideShowsEveryComponentTest. The content groups are the
 * elements a browser hands us before any class is written - a heading, a rule,
 * a block of code, a table - which nobody assembles and which therefore cannot
 * prove they exist by having a file; they are checked from both sides, by
 * tests/Template/ContentGroupRegistryTest against assets/base.css and by
 * tests/Template/StyleguideShowsEveryContentGroupTest against this page.
 *
 * The {define}s at the top are the page's own furniture (the .sg-* classes in
 * assets/base.css), not components: they frame the specimens and are used
 * nowhere else. They are what makes the page measurable - every section carries
 * data-styleguide-component or data-styleguide-content and every specimen
 * carries data-styleguide-variant, which is what those tests read.
 *
 * The example content is invented and has to stay invented.
 *}

{import '../../../components/site-header.latte'}
{import '../../../components/nav.latte'}
{import '../../../components/site-footer.latte'}
{import '../../../components/page-heading.latte'}
{import '../../../components/card.latte'}
{import '../../../components/button.latte'}
{import '../../../components/badge.latte'}
{import '../../../components/field.latte'}
{import '../../../components/notice.latte'}
{import '../../../components/marker-list.latte'}
{import '../../../components/panel.latte'}
{import '../../../components/prose.latte'}
{import '../../../components/table.latte'}
{import '../../../components/swatch.latte'}

{define sgSection, Trilobit\Core\Presentation\Component\Component $component}
    <section class="sg-section l-stack" data-styleguide-component="{$component->name}">
        <h2 class="sg-section__name">{$component->name}</h2>

        <p class="sg-section__summary">{$component->summary}</p>

        <div class="l-stack">{block sgSectionBody}{/block}</div>
    </section>
{/define}

{define sgContentSection, Trilobit\Core\Presentation\Content\ContentGroup $group}
    <section class="sg-section l-stack" data-styleguide-content="{$group->name}">
        <h2 class="sg-section__name">{$group->name}</h2>

        <p class="sg-section__summary">{$group->summary}</p>

        <div class="l-stack">{block sgContentSectionBody}{/block}</div>
    </section>
{/define}

{*
 * Something to look at, for the specimens that need a picture.
 *
 * Drawn here rather than loaded, because an image file would be one more thing
 * to keep beside the page and this one has to follow the ink of whichever theme
 * is on - which it does by being filled with currentColor. It carries width and
 * height so that the rule about images having to keep their own shape has
 * something to keep.
 *}
{define sgSpecimenDrawing}
    <svg
        width="320"
        height="180"
        viewBox="0 0 320 180"
        role="img"
        aria-label="An invented specimen: seven segments narrowing from a head shield to a tail."
    >
        <rect x="1" y="1" width="318" height="178" fill="none" stroke="currentColor" stroke-opacity="0.25" stroke-width="2" />

        <g fill="currentColor" fill-opacity="0.6">
            <ellipse cx="160" cy="36" rx="60" ry="22" />
            <ellipse cx="160" cy="66" rx="53" ry="12" />
            <ellipse cx="160" cy="88" rx="46" ry="11" />
            <ellipse cx="160" cy="108" rx="39" ry="10" />
            <ellipse cx="160" cy="126" rx="31" ry="9" />
            <ellipse cx="160" cy="142" rx="23" ry="8" />
            <ellipse cx="160" cy="157" rx="14" ry="7" />
        </g>
    </svg>
{/define}

{define sgSpecimen, string $variant, bool $narrow = false}
    <div class="sg-specimen" data-styleguide-variant="{$variant}">
        <div n:class="'sg-specimen__stage', $narrow ? 'sg-specimen__stage--narrow'">{block sgSpecimenStage}{/block}</div>

        <p class="sg-specimen__label">{$variant}</p>
    </div>
{/define}

{block content}
    {include pageHeading,
        title: 'Style guide',
        lead: 'Every component this application is built out of, rendered by the application itself.',
        testId: 'styleguide-headline'}

    {*
     * The switch. A control says which preference it sets and to what, and
     * nothing else: assets/app.ts moves the attribute on <html> and tells the
     * server, so a fourth preference is one more control here and no more
     * script. The state a control is drawn in comes from the server too, which
     * is what makes a reload show what was chosen rather than what the build
     * starts in - decision D8.
     *
     * It is preferred() and not value() that decides which control is pressed:
     * the switch shows the person's own setting, which is not always the width
     * the page it happens to be on is drawn at - see
     * Trilobit\Core\Preference\Preferences.
     *
     * tests/Template/StyleguideOffersEveryPreferenceTest fails when this list
     * and the catalogue part company in either direction.
     *}
    <div class="l-stack" data-testid="theme-switcher">
        <div class="l-cluster">
            <span class="text-sm text-ink-muted">Theme</span>

            {foreach $themes as $available}
                {var bool $chosen = $available === $preferences->preferred('theme')}

                {include button,
                    label: $available,
                    variant: $chosen ? 'primary' : 'quiet',
                    testId: 'theme-choice-' . $available,
                    attributes: [
                        'data-preference' => 'theme',
                        'data-preference-value' => $available,
                        'aria-pressed' => $chosen ? 'true' : 'false',
                    ]}
            {/foreach}
        </div>

        <div class="l-cluster">
            <span class="text-sm text-ink-muted">Mode</span>

            {foreach ['system' => 'System', 'light' => 'Light', 'dark' => 'Dark'] as $mode => $label}
                {var bool $chosen = $mode === $preferences->preferred('theme-mode')}

                {include button,
                    label: $label,
                    variant: $chosen ? 'primary' : 'quiet',
                    testId: 'theme-mode-choice-' . $mode,
                    attributes: [
                        'data-preference' => 'theme-mode',
                        'data-preference-value' => $mode,
                        'aria-pressed' => $chosen ? 'true' : 'false',
                    ]}
            {/foreach}
        </div>

        {*
         * How much of the screen the content is given. The names are the
         * modes themselves rather than sizes, because what each of them
         * measures is the theme's to decide and changes when the theme does.
         *}
        <div class="l-cluster">
            <span class="text-sm text-ink-muted">Width</span>

            {foreach ['content' => 'Content', 'wide' => 'Wide', 'full' => 'Full'] as $mode => $label}
                {var bool $chosen = $mode === $preferences->preferred('content-width')}

                {include button,
                    label: $label,
                    variant: $chosen ? 'primary' : 'quiet',
                    testId: 'content-width-choice-' . $mode,
                    attributes: [
                        'data-preference' => 'content-width',
                        'data-preference-value' => $mode,
                        'aria-pressed' => $chosen ? 'true' : 'false',
                    ]}
            {/foreach}
        </div>

        {*
         * The other half of the arrangement, and the only place it can be
         * seen: a page the application draws at a width of its own, whatever
         * is chosen above. It is a second action of this very presenter,
         * which is the point - a width belongs to the page and not to the
         * class behind it.
         *}
        <p class="text-sm text-ink-muted">
            A page may insist on a width of its own where it has to:
            <a href="{$fullWidthUrl}" data-testid="styleguide-full-width-link">see one that does</a>.
        </p>
    </div>

    {embed block panel, testId: 'styleguide-tokens'}
        {block panelTitle}Colour tokens{/block}

        {block panelBody}
            <div class="l-grid">
                {foreach $colourTokens as $token => $role}
                    {include swatch, name: $token, role: $role, testId: 'swatch-' . $token}
                {/foreach}
            </div>
        {/block}
    {/embed}

    {*
     * The elements a browser hands us before any class is written. They are
     * catalogued the same way the components are and for the same reason: a
     * paragraph about <mark> would render whether or not anything ever styled
     * <mark>, so every group below names the rules it stands for and
     * tests/Template/ContentGroupRegistryTest checks them against
     * assets/base.css.
     *}
    {embed block sgContentSection, group: $contentGroups['reboot']}
        {block sgContentSectionBody}
            {embed block sgSpecimen, variant: 'a rule'}
                {block sgSpecimenStage}
                    <div class="l-stack">
                        <p>Segments counted from the front of the head shield.</p>

                        <hr>

                        <p>Segments counted from the back of the tail shield.</p>
                    </div>
                {/block}
            {/embed}

            {embed block sgSpecimen, variant: 'emphasis and small print'}
                {block sgSpecimenStage}
                    <div class="l-stack">
                        <p>
                            A specimen is <strong>complete</strong> when the head, the body and the tail
                            are all present; anything else is <mark>a fragment</mark>, however good it
                            looks. Measurements are given in <abbr title="millimetres">mm</abbr>.
                        </p>

                        <p><small>Every measurement on this page was invented for it.</small></p>
                    </div>
                {/block}
            {/embed}

            {embed block sgSpecimen, variant: 'a quotation'}
                {block sgSpecimenStage}
                    <blockquote>
                        Three lobes along one axis, which is where the name comes from, and not three
                        parts from front to back, which is what everybody guesses.
                    </blockquote>
                {/block}
            {/embed}

            {embed block sgSpecimen, variant: 'a list of terms'}
                {block sgSpecimenStage}
                    <dl class="l-stack">
                        <div>
                            <dt>Cephalon</dt>
                            <dd>The head shield, and the part that survives on its own most often.</dd>
                        </div>

                        <div>
                            <dt>Thorax</dt>
                            <dd>The jointed middle, which is what let the animal roll up.</dd>
                        </div>

                        <div>
                            <dt>Pygidium</dt>
                            <dd>The tail shield, fused from segments the thorax never released.</dd>
                        </div>
                    </dl>
                {/block}
            {/embed}
        {/block}
    {/embed}

    {embed block sgContentSection, group: $contentGroups['typography']}
        {block sgContentSectionBody}
            {embed block sgSpecimen, variant: 'the heading scale'}
                {block sgSpecimenStage}
                    <div class="l-stack">
                        <h1>Heading one</h1>
                        <h2>Heading two</h2>
                        <h3>Heading three</h3>
                        <h4>Heading four</h4>
                        <h5>Heading five</h5>
                        <h6>Heading six</h6>
                    </div>
                {/block}
            {/embed}

            {embed block sgSpecimen, variant: 'running text'}
                {block sgSpecimenStage}
                    <p class="l-measure">
                        Body text is set at the base step of the scale, at the line height the theme
                        asks for, and kept to a measure a reader can come back from at the end of a
                        line. The measure is a layout token rather than a property of the paragraph,
                        so a page decides how wide its text runs and the text itself does not.
                    </p>
                {/block}
            {/embed}
        {/block}
    {/embed}

    {embed block sgContentSection, group: $contentGroups['code']}
        {block sgContentSectionBody}
            {embed block sgSpecimen, variant: 'inline'}
                {block sgSpecimenStage}
                    <p>
                        Switching the theme is one attribute: <code>data-theme="ledger"</code> on the
                        <code>html</code> element, and nothing is rebuilt.
                    </p>
                {/block}
            {/embed}

            {embed block sgSpecimen, variant: 'a key and sampled output'}
                {block sgSpecimenStage}
                    <p>
                        Press <kbd>Tab</kbd> until the frame below is reached, then <kbd>Shift</kbd> +
                        <kbd>Tab</kbd> to leave it again. A build that has nothing to say answers
                        <samp>no drift</samp> and stops.
                    </p>
                {/block}
            {/embed}

            {embed block sgSpecimen, variant: 'a block wider than its frame'}
                {block sgSpecimenStage}
                    <pre data-testid="styleguide-code-block"><code>docker compose exec php vendor/bin/phpunit --filter 'ContentGroupRegistryTest|StyleguideShowsEveryContentGroupTest' --testdox --colors=never --display-skipped</code></pre>
                {/block}
            {/embed}
        {/block}
    {/embed}

    {embed block sgContentSection, group: $contentGroups['images']}
        {block sgContentSectionBody}
            {embed block sgSpecimen, variant: 'at the size it was drawn'}
                {block sgSpecimenStage}
                    {include sgSpecimenDrawing}
                {/block}
            {/embed}

            {embed block sgSpecimen, variant: 'in a frame narrower than itself', narrow: true}
                {block sgSpecimenStage}
                    {include sgSpecimenDrawing}
                {/block}
            {/embed}
        {/block}
    {/embed}

    {embed block sgContentSection, group: $contentGroups['tables']}
        {block sgContentSectionBody}
            {embed block sgSpecimen, variant: 'default'}
                {block sgSpecimenStage}
                    {embed block table, caption: 'Three invented specimens'}
                        {block tableHead}
                            <tr>
                                <th scope="col">Specimen</th>
                                <th scope="col">Period</th>
                                <th scope="col">Found in</th>
                            </tr>
                        {/block}

                        {block tableBody}
                            <tr>
                                <th scope="row">Segmented disc</th>
                                <td>Cambrian</td>
                                <td>A quarry nobody named</td>
                            </tr>

                            <tr>
                                <th scope="row">Rolled specimen</th>
                                <td>Ordovician</td>
                                <td>A road cutting</td>
                            </tr>

                            <tr>
                                <th scope="row">Tail shield</th>
                                <td>Silurian</td>
                                <td>A drawer in a museum</td>
                            </tr>
                        {/block}
                    {/embed}
                {/block}
            {/embed}

            {embed block sgSpecimen, variant: 'figures and an actions column'}
                {block sgSpecimenStage}
                    {embed block table, caption: 'Specimens, with what may be done to each'}
                        {block tableHead}
                            <tr>
                                <th scope="col">Specimen</th>
                                <th scope="col" class="c-table__number">Length</th>
                                <th scope="col" class="c-table__number">Segments</th>
                                <th scope="col" class="c-table__actions">
                                    <span class="u-visually-hidden">What may be done</span>
                                </th>
                            </tr>
                        {/block}

                        {block tableBody}
                            <tr>
                                <th scope="row">Segmented disc</th>
                                <td class="c-table__number">118</td>
                                <td class="c-table__number">11</td>
                                <td class="c-table__actions">
                                    {include button, label: 'Open', href: '#', variant: 'quiet'}
                                </td>
                            </tr>

                            <tr>
                                <th scope="row">Rolled specimen</th>
                                <td class="c-table__number">64</td>
                                <td class="c-table__number">9</td>
                                <td class="c-table__actions">
                                    {include button, label: 'Open', href: '#', variant: 'quiet'}
                                </td>
                            </tr>

                            <tr>
                                <th scope="row">Tail shield</th>
                                <td class="c-table__number">7</td>
                                <td class="c-table__number">4</td>
                                <td class="c-table__actions">
                                    {include button, label: 'Open', href: '#', variant: 'quiet'}
                                </td>
                            </tr>
                        {/block}
                    {/embed}
                {/block}
            {/embed}

            {*
             * The case .ai/plans/09-chrome-a-sirka-obsahu.md was written for: a
             * column for every month, which is wider than the frame at any
             * content width. It has to scroll here and leave the page alone.
             *}
            {embed block sgSpecimen, variant: 'wider than its frame'}
                {block sgSpecimenStage}
                    {embed block table, caption: 'Specimens catalogued on each day of the month', testId: 'styleguide-table-wide'}
                        {block tableHead}
                            <tr>
                                <th scope="col">Month</th>

                                <th n:foreach="$tableColumns as $day" scope="col" class="c-table__number">{$day}</th>
                            </tr>
                        {/block}

                        {block tableBody}
                            <tr n:foreach="$tableRows as $label => $counts">
                                <th scope="row">{$label}</th>

                                <td n:foreach="$counts as $count" class="c-table__number">{$count}</td>
                            </tr>
                        {/block}
                    {/embed}
                {/block}
            {/embed}
        {/block}
    {/embed}

    {embed block sgContentSection, group: $contentGroups['figures']}
        {block sgContentSectionBody}
            {embed block sgSpecimen, variant: 'default'}
                {block sgSpecimenStage}
                    <figure>
                        {include sgSpecimenDrawing}

                        <figcaption>
                            An invented specimen, drawn rather than photographed, so that it costs the
                            page no request and follows the ink of whichever theme is on.
                        </figcaption>
                    </figure>
                {/block}
            {/embed}
        {/block}
    {/embed}

    {embed block sgSection, component: $components['c-site-header']}
        {block sgSectionBody}
            {embed block sgSpecimen, variant: 'default'}
                {block sgSpecimenStage}
                    {include siteHeader, brand: 'Trilobit', href: '#'}
                {/block}
            {/embed}

            {embed block sgSpecimen, variant: 'with a tagline'}
                {block sgSpecimenStage}
                    {include siteHeader,
                        brand: 'Trilobit',
                        href: '#',
                        tagline: 'Modular commerce, contacts and content.'}
                {/block}
            {/embed}
        {/block}
    {/embed}

    {embed block sgSection, component: $components['c-nav']}
        {block sgSectionBody}
            {embed block sgSpecimen, variant: 'default'}
                {block sgSpecimenStage}
                    {include nav, items: $sampleNavigation, label: 'Specimen'}
                {/block}
            {/embed}
        {/block}
    {/embed}

    {embed block sgSection, component: $components['c-site-footer']}
        {block sgSectionBody}
            {embed block sgSpecimen, variant: 'default'}
                {block sgSpecimenStage}
                    {embed block siteFooter}
                        {block siteFooterBody}<p>Trilobit &mdash; open source, MIT.</p>{/block}
                    {/embed}
                {/block}
            {/embed}
        {/block}
    {/embed}

    {embed block sgSection, component: $components['c-page-heading']}
        {block sgSectionBody}
            {embed block sgSpecimen, variant: 'default'}
                {block sgSpecimenStage}
                    {include pageHeading,
                        title: 'Trilobite field guide',
                        lead: 'How to tell one segmented fossil from the next without a hand lens.'}
                {/block}
            {/embed}

            {embed block sgSpecimen, variant: 'without a lead'}
                {block sgSpecimenStage}
                    {include pageHeading, title: 'Trilobite field guide'}
                {/block}
            {/embed}

            {embed block sgSpecimen, variant: 'as a section heading'}
                {block sgSpecimenStage}
                    {include pageHeading,
                        title: 'Segments and lobes',
                        lead: 'Three lobes along one axis, which is where the name comes from.',
                        level: 'h3'}
                {/block}
            {/embed}
        {/block}
    {/embed}

    {embed block sgSection, component: $components['c-card']}
        {block sgSectionBody}
            {embed block sgSpecimen, variant: 'default'}
                {block sgSpecimenStage}
                    <div class="l-grid">
                        {include card,
                            title: 'Ammonite mug',
                            href: '#',
                            text: 'Stoneware, spiral in relief, holds three hundred millilitres.',
                            media: 'A'}

                        {include card,
                            title: 'Crinoid print',
                            href: '#',
                            text: 'Ink on cotton paper, unframed, four hundred by five hundred.',
                            media: 'C'}
                    </div>
                {/block}
            {/embed}

            {embed block sgSpecimen, variant: 'without media'}
                {block sgSpecimenStage}
                    <div class="l-grid">
                        {include card,
                            title: 'Brachiopod cast',
                            href: '#',
                            text: 'Plaster, hand finished, one of a numbered run of forty.'}
                    </div>
                {/block}
            {/embed}
        {/block}
    {/embed}

    {embed block sgSection, component: $components['c-button']}
        {block sgSectionBody}
            {embed block sgSpecimen, variant: 'primary'}
                {block sgSpecimenStage}
                    {include button, label: 'Add to basket', href: '#'}
                {/block}
            {/embed}

            {embed block sgSpecimen, variant: 'quiet'}
                {block sgSpecimenStage}
                    {include button, label: 'Keep looking', href: '#', variant: 'quiet'}
                {/block}
            {/embed}

            {embed block sgSpecimen, variant: 'without a destination'}
                {block sgSpecimenStage}
                    {include button, label: 'Recalculate'}
                {/block}
            {/embed}
        {/block}
    {/embed}

    {embed block sgSection, component: $components['c-badge']}
        {block sgSectionBody}
            {embed block sgSpecimen, variant: 'plain'}
                {block sgSpecimenStage}
                    {include badge, label: 'Draft'}
                {/block}
            {/embed}

            {embed block sgSpecimen, variant: 'accent'}
                {block sgSpecimenStage}
                    {include badge, label: 'In this build', variant: 'accent'}
                {/block}
            {/embed}
        {/block}
    {/embed}

    {embed block sgSection, component: $components['c-field']}
        {block sgSectionBody}
            {embed block sgSpecimen, variant: 'default'}
                {block sgSpecimenStage}
                    {embed block field}
                        {block fieldLabel}<label for="sg-field-town">Town</label>{/block}

                        {block fieldControl}
                            <input id="sg-field-town" type="text" value="Barrandov">
                        {/block}
                    {/embed}
                {/block}
            {/embed}

            {embed block sgSpecimen, variant: 'with a control that is not a line of text'}
                {block sgSpecimenStage}
                    {embed block field}
                        {block fieldLabel}<label for="sg-field-period">Period</label>{/block}

                        {block fieldControl}
                            <select id="sg-field-period">
                                <option>Cambrian</option>
                                <option>Ordovician</option>
                                <option>Silurian</option>
                            </select>
                        {/block}
                    {/embed}
                {/block}
            {/embed}
        {/block}
    {/embed}

    {embed block sgSection, component: $components['c-notice']}
        {block sgSectionBody}
            {embed block sgSpecimen, variant: 'info'}
                {block sgSpecimenStage}
                    {include notice, message: 'The catalogue was saved.'}
                {/block}
            {/embed}

            {embed block sgSpecimen, variant: 'danger'}
                {block sgSpecimenStage}
                    {include notice, message: 'The address or the password is not right.', variant: 'danger'}
                {/block}
            {/embed}
        {/block}
    {/embed}

    {embed block sgSection, component: $components['c-marker-list']}
        {block sgSectionBody}
            {embed block sgSpecimen, variant: 'default'}
                {block sgSpecimenStage}
                    {include markerList, items: $statements}
                {/block}
            {/embed}
        {/block}
    {/embed}

    {embed block sgSection, component: $components['c-panel']}
        {block sgSectionBody}
            {embed block sgSpecimen, variant: 'default'}
                {block sgSpecimenStage}
                    {embed block panel}
                        {block panelTitle}What a panel is for{/block}

                        {block panelBody}
                            <p>Anything that belongs together and wants an edge drawn round it.</p>
                        {/block}
                    {/embed}
                {/block}
            {/embed}
        {/block}
    {/embed}

    {embed block sgSection, component: $components['c-prose']}
        {block sgSectionBody}
            {embed block sgSpecimen, variant: 'default'}
                {block sgSpecimenStage}
                    {embed block prose}
                        {block proseBody}
                            <p class="l-measure">
                                Everywhere else the space between blocks comes from the layout and a
                                list has no marker. Here both come back, because this is a document
                                rather than an arrangement of parts.
                            </p>

                            <h3>What that costs</h3>

                            <p class="l-measure">
                                Only that a page has to say so. The elements themselves are the ones
                                the browser already knows.
                            </p>

                            <ul class="l-measure">
                                <li>A list item gets its marker back.</li>
                                <li>A heading takes more room above it than below.</li>
                                <li>The first and last block sit flush with whatever frames them.</li>
                            </ul>

                            <hr>

                            <p class="l-measure"><small>Everything written above was invented for this page.</small></p>
                        {/block}
                    {/embed}
                {/block}
            {/embed}
        {/block}
    {/embed}

    {embed block sgSection, component: $components['c-table']}
        {block sgSectionBody}
            {embed block sgSpecimen, variant: 'default'}
                {block sgSpecimenStage}
                    {embed block table, caption: 'Where each drawer is kept'}
                        {block tableHead}
                            <tr>
                                <th scope="col">Drawer</th>
                                <th scope="col">Room</th>
                            </tr>
                        {/block}

                        {block tableBody}
                            <tr>
                                <th scope="row">Head shields</th>
                                <td>The one with the window</td>
                            </tr>

                            <tr>
                                <th scope="row">Tail shields</th>
                                <td>The one without</td>
                            </tr>
                        {/block}
                    {/embed}
                {/block}
            {/embed}

            {*
             * The caption is there either way - a frame that scrolls has to
             * have a name for anybody arriving at it by keyboard. What this
             * variant changes is only whether the name is also drawn.
             *}
            {embed block sgSpecimen, variant: 'with a visible caption'}
                {block sgSpecimenStage}
                    {embed block table, caption: 'Where each drawer is kept', captionVisible: true}
                        {block tableHead}
                            <tr>
                                <th scope="col">Drawer</th>
                                <th scope="col">Room</th>
                            </tr>
                        {/block}

                        {block tableBody}
                            <tr>
                                <th scope="row">Head shields</th>
                                <td>The one with the window</td>
                            </tr>

                            <tr>
                                <th scope="row">Tail shields</th>
                                <td>The one without</td>
                            </tr>
                        {/block}
                    {/embed}
                {/block}
            {/embed}
        {/block}
    {/embed}

    {embed block sgSection, component: $components['c-swatch']}
        {block sgSectionBody}
            {embed block sgSpecimen, variant: 'default'}
                {block sgSpecimenStage}
                    {include swatch, name: '--color-accent', role: 'the action a page is about'}
                {/block}
            {/embed}
        {/block}
    {/embed}
{/block}
