{templateType Trilobit\Core\Presentation\Styleguide\OverviewDefaultTemplate}

{*
 * The front page of the style guide: the way into every page of it, and
 * nothing else.
 *
 * Every specimen has a page of its own, and this page leads to all of them,
 * group by group, with c-signpost - drawn out of the same list of pages,
 * Trilobit\Core\Presentation\Styleguide\StyleguidePages, that the menu beside
 * it and the routes are made from. tests/Template/StyleguideFrameTest holds it
 * to that list, and fails if a specimen is left here, where the menu would
 * send nobody to it.
 *}

{import '../../../components/page-heading.latte'}
{import '../../../components/signpost.latte'}

{block sgPage}
    <div class="l-stack l-stack--loose" data-testid="styleguide-signposts">
        <section n:foreach="$guide as $group" class="l-stack" data-testid="styleguide-group-{$group->name}">
            {include pageHeading, title: $group->title, lead: $group->summary, level: 'h2'}

            {include signpost,
                items: $group->signposts,
                label: $group->title,
                testId: 'styleguide-signpost-' . $group->name}
        </section>
    </div>
{/block}
