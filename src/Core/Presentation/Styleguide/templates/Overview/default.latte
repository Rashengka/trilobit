{templateType Trilobit\Core\Presentation\Styleguide\OverviewDefaultTemplate}

{*
 * The front page of the style guide: the way into every page of it, and the
 * specimens of the components.
 *
 * Every specimen below is an {include} of a file in
 * src/Core/Presentation/components/ - the same files the homepage and the
 * modules include. Nothing here reproduces a component's markup, because a
 * catalogue that reproduced it would go on showing the old shape after the
 * component changed and nobody would know. They are checked by
 * tests/Template/StyleguideShowsEveryComponentTest, which asks every page the
 * router sends to the guide rather than this one.
 *
 * The frames around the specimens are the guide's own furniture, imported
 * from ../furniture.latte so that a specimen is framed and marked the same way
 * on whichever page it is.
 *
 * The example content is invented and has to stay invented.
 *}

{import '../furniture.latte'}
{import '../../../components/preference-switcher.latte'}
{import '../../../components/site-header.latte'}
{import '../../../components/user-menu.latte'}
{import '../../../components/nav.latte'}
{import '../../../components/site-footer.latte'}
{import '../../../components/page-heading.latte'}
{import '../../../components/card.latte'}
{import '../../../components/signpost.latte'}
{import '../../../components/button.latte'}
{import '../../../components/badge.latte'}
{import '../../../components/icon.latte'}
{import '../../../components/field.latte'}
{import '../../../components/notice.latte'}
{import '../../../components/marker-list.latte'}
{import '../../../components/panel.latte'}
{import '../../../components/prose.latte'}
{import '../../../components/table.latte'}
{import '../../../components/swatch.latte'}

{*
 * No switch from the frame on this page: the specimen of c-preference-switcher
 * below is the switch, and a second one would put two controls for every
 * answer on one page.
 *}
{block sgSwitch}{/block}

{block sgPage}
    {*
     * The way into every page of the guide, drawn from the same list the menu
     * beside it and the routes are made from.
     *}
    <div class="l-stack l-stack--loose" data-testid="styleguide-signposts">
        <section n:foreach="$guide as $group" class="l-stack" data-testid="styleguide-group-{$group->name}">
            {include pageHeading, title: $group->title, lead: $group->summary, level: 'h2'}

            {include signpost, items: $group->signposts, label: $group->title}
        </section>
    </div>

    {*
     * The switch, which is at once the specimen of c-preference-switcher: the
     * one component on this page that is used rather than shown, so it is shown
     * by being used. A second copy further down would put two controls for
     * every answer on one page, and the script moving aria-pressed would have
     * two of everything to keep in step. That is why the component is first in
     * Trilobit\Core\Presentation\Component\ComponentRegistry - the sections
     * are checked in the register's order.
     *
     * The state a control is drawn in comes from the server, which is what
     * makes a reload show what was chosen rather than what the build starts
     * in - decision D8.
     *}
    {embed block sgSection, component: $components['c-preference-switcher']}
        {block sgSectionBody}
            {embed block sgSpecimen, variant: 'default'}
                {block sgSpecimenStage}
                    {include preferenceSwitcher, preferences: $preferences, testId: 'theme-switcher'}
                {/block}
            {/embed}
        {/block}
    {/embed}

    {embed block sgSection, component: $components['c-site-header']}
        {block sgSectionBody}
            {embed block sgSpecimen, variant: 'default'}
                {block sgSpecimenStage}
                    {include siteHeader, brand: 'Trilobit', href: '#'}
                {/block}
            {/embed}

            {embed block sgSpecimen, variant: 'with a tagline'}
                {block sgSpecimenStage}
                    {include siteHeader,
                        brand: 'Trilobit',
                        href: '#',
                        tagline: 'Modular commerce, contacts and content.'}
                {/block}
            {/embed}

            {embed block sgSpecimen, variant: 'with something at the end'}
                {block sgSpecimenStage}
                    {embed block siteHeader, brand: 'Trilobit', href: '#', tagline: 'Administration'}
                        {block siteHeaderEnd}
                            {include button, label: 'Somebody', variant: 'quiet', icon: 'chevron-down'}
                        {/block}
                    {/embed}
                {/block}
            {/embed}
        {/block}
    {/embed}

    {*
     * The menu is drawn closed, as it is in the banner; the button opens it.
     * What the administration puts between who they are and the ways out is the
     * preference switch, which is not repeated here - the one at the top of
     * this page is that switch's specimen, and a second would put two controls
     * for every answer on one page.
     *}
    {embed block sgSection, component: $components['c-user-menu']}
        {block sgSectionBody}
            {embed block sgSpecimen, variant: 'default'}
                {block sgSpecimenStage}
                    {embed block userMenu,
                        id: 'sg-user-menu-panel',
                        name: 'Pia Paradoxides',
                        email: 'pia@example.com',
                        signOutUrl: '#',
                        publicSiteUrl: '#'}
                        {block userMenuBody}
                            <p class="text-sm text-ink-muted">Whatever the page offers the person it belongs to.</p>
                        {/block}
                    {/embed}
                {/block}
            {/embed}
        {/block}
    {/embed}

    {embed block sgSection, component: $components['c-nav']}
        {block sgSectionBody}
            {embed block sgSpecimen, variant: 'default'}
                {block sgSpecimenStage}
                    {include nav, items: $sampleNavigation, label: 'Specimen'}
                {/block}
            {/embed}
        {/block}
    {/embed}

    {embed block sgSection, component: $components['c-site-footer']}
        {block sgSectionBody}
            {embed block sgSpecimen, variant: 'default'}
                {block sgSpecimenStage}
                    {embed block siteFooter}
                        {block siteFooterBody}<p>Trilobit &mdash; open source, MIT.</p>{/block}
                    {/embed}
                {/block}
            {/embed}
        {/block}
    {/embed}

    {embed block sgSection, component: $components['c-page-heading']}
        {block sgSectionBody}
            {embed block sgSpecimen, variant: 'default'}
                {block sgSpecimenStage}
                    {include pageHeading,
                        title: 'Trilobite field guide',
                        lead: 'How to tell one segmented fossil from the next without a hand lens.'}
                {/block}
            {/embed}

            {embed block sgSpecimen, variant: 'without a lead'}
                {block sgSpecimenStage}
                    {include pageHeading, title: 'Trilobite field guide'}
                {/block}
            {/embed}

            {embed block sgSpecimen, variant: 'as a section heading'}
                {block sgSpecimenStage}
                    {include pageHeading,
                        title: 'Segments and lobes',
                        lead: 'Three lobes along one axis, which is where the name comes from.',
                        level: 'h3'}
                {/block}
            {/embed}
        {/block}
    {/embed}

    {embed block sgSection, component: $components['c-card']}
        {block sgSectionBody}
            {embed block sgSpecimen, variant: 'default'}
                {block sgSpecimenStage}
                    <div class="l-grid">
                        {include card,
                            title: 'Ammonite mug',
                            href: '#',
                            text: 'Stoneware, spiral in relief, holds three hundred millilitres.',
                            media: 'A'}

                        {include card,
                            title: 'Crinoid print',
                            href: '#',
                            text: 'Ink on cotton paper, unframed, four hundred by five hundred.',
                            media: 'C'}
                    </div>
                {/block}
            {/embed}

            {embed block sgSpecimen, variant: 'without media'}
                {block sgSpecimenStage}
                    <div class="l-grid">
                        {include card,
                            title: 'Brachiopod cast',
                            href: '#',
                            text: 'Plaster, hand finished, one of a numbered run of forty.'}
                    </div>
                {/block}
            {/embed}
        {/block}
    {/embed}

    {embed block sgSection, component: $components['c-signpost']}
        {block sgSectionBody}
            {embed block sgSpecimen, variant: 'default'}
                {block sgSpecimenStage}
                    {include signpost, items: $sampleSignposts, label: 'Specimen', testId: 'sample-signpost'}
                {/block}
            {/embed}
        {/block}
    {/embed}

    {embed block sgSection, component: $components['c-button']}
        {block sgSectionBody}
            {embed block sgSpecimen, variant: 'primary'}
                {block sgSpecimenStage}
                    {include button, label: 'Add to basket', href: '#'}
                {/block}
            {/embed}

            {embed block sgSpecimen, variant: 'quiet'}
                {block sgSpecimenStage}
                    {include button, label: 'Keep looking', href: '#', variant: 'quiet'}
                {/block}
            {/embed}

            {embed block sgSpecimen, variant: 'without a destination'}
                {block sgSpecimenStage}
                    {include button, label: 'Recalculate'}
                {/block}
            {/embed}

            {embed block sgSpecimen, variant: 'with an icon'}
                {block sgSpecimenStage}
                    {include button, label: 'Sign out', href: '#', variant: 'quiet', icon: 'sign-out'}
                {/block}
            {/embed}
        {/block}
    {/embed}

    {*
     * Each icon on its own, which is the case where it has to carry a name -
     * beside a word that already says what it means it would carry none.
     *}
    {embed block sgSection, component: $components['c-icon']}
        {block sgSectionBody}
            {embed block sgSpecimen, variant: 'sign-out'}
                {block sgSpecimenStage}
                    {include icon, name: 'sign-out', label: 'Sign out'}
                {/block}
            {/embed}

            {embed block sgSpecimen, variant: 'chevron-down'}
                {block sgSpecimenStage}
                    {include icon, name: 'chevron-down', label: 'Opens underneath'}
                {/block}
            {/embed}
        {/block}
    {/embed}

    {embed block sgSection, component: $components['c-badge']}
        {block sgSectionBody}
            {embed block sgSpecimen, variant: 'plain'}
                {block sgSpecimenStage}
                    {include badge, label: 'Draft'}
                {/block}
            {/embed}

            {embed block sgSpecimen, variant: 'accent'}
                {block sgSpecimenStage}
                    {include badge, label: 'In this build', variant: 'accent'}
                {/block}
            {/embed}
        {/block}
    {/embed}

    {embed block sgSection, component: $components['c-field']}
        {block sgSectionBody}
            {embed block sgSpecimen, variant: 'default'}
                {block sgSpecimenStage}
                    {embed block field}
                        {block fieldLabel}<label for="sg-field-town">Town</label>{/block}

                        {block fieldControl}
                            <input id="sg-field-town" type="text" value="Barrandov">
                        {/block}
                    {/embed}
                {/block}
            {/embed}

            {embed block sgSpecimen, variant: 'with a control that is not a line of text'}
                {block sgSpecimenStage}
                    {embed block field}
                        {block fieldLabel}<label for="sg-field-period">Period</label>{/block}

                        {block fieldControl}
                            <select id="sg-field-period">
                                <option>Cambrian</option>
                                <option>Ordovician</option>
                                <option>Silurian</option>
                            </select>
                        {/block}
                    {/embed}
                {/block}
            {/embed}
        {/block}
    {/embed}

    {embed block sgSection, component: $components['c-notice']}
        {block sgSectionBody}
            {embed block sgSpecimen, variant: 'info'}
                {block sgSpecimenStage}
                    {include notice, message: 'The catalogue was saved.'}
                {/block}
            {/embed}

            {embed block sgSpecimen, variant: 'danger'}
                {block sgSpecimenStage}
                    {include notice, message: 'The address or the password is not right.', variant: 'danger'}
                {/block}
            {/embed}
        {/block}
    {/embed}

    {embed block sgSection, component: $components['c-marker-list']}
        {block sgSectionBody}
            {embed block sgSpecimen, variant: 'default'}
                {block sgSpecimenStage}
                    {include markerList, items: $statements}
                {/block}
            {/embed}
        {/block}
    {/embed}

    {embed block sgSection, component: $components['c-panel']}
        {block sgSectionBody}
            {embed block sgSpecimen, variant: 'default'}
                {block sgSpecimenStage}
                    {embed block panel}
                        {block panelTitle}What a panel is for{/block}

                        {block panelBody}
                            <p>Anything that belongs together and wants an edge drawn round it.</p>
                        {/block}
                    {/embed}
                {/block}
            {/embed}
        {/block}
    {/embed}

    {embed block sgSection, component: $components['c-prose']}
        {block sgSectionBody}
            {embed block sgSpecimen, variant: 'default'}
                {block sgSpecimenStage}
                    {embed block prose}
                        {block proseBody}
                            <p class="l-measure">
                                Everywhere else the space between blocks comes from the layout and a
                                list has no marker. Here both come back, because this is a document
                                rather than an arrangement of parts.
                            </p>

                            <h3>What that costs</h3>

                            <p class="l-measure">
                                Only that a page has to say so. The elements themselves are the ones
                                the browser already knows.
                            </p>

                            <ul class="l-measure">
                                <li>A list item gets its marker back.</li>
                                <li>A heading takes more room above it than below.</li>
                                <li>The first and last block sit flush with whatever frames them.</li>
                            </ul>

                            <hr>

                            <p class="l-measure"><small>Everything written above was invented for this page.</small></p>
                        {/block}
                    {/embed}
                {/block}
            {/embed}
        {/block}
    {/embed}

    {embed block sgSection, component: $components['c-table']}
        {block sgSectionBody}
            {embed block sgSpecimen, variant: 'default'}
                {block sgSpecimenStage}
                    {embed block table, caption: 'Where each drawer is kept'}
                        {block tableHead}
                            <tr>
                                <th scope="col">Drawer</th>
                                <th scope="col">Room</th>
                            </tr>
                        {/block}

                        {block tableBody}
                            <tr>
                                <th scope="row">Head shields</th>
                                <td>The one with the window</td>
                            </tr>

                            <tr>
                                <th scope="row">Tail shields</th>
                                <td>The one without</td>
                            </tr>
                        {/block}
                    {/embed}
                {/block}
            {/embed}

            {*
             * The caption is there either way - a frame that scrolls has to
             * have a name for anybody arriving at it by keyboard. What this
             * variant changes is only whether the name is also drawn.
             *}
            {embed block sgSpecimen, variant: 'with a visible caption'}
                {block sgSpecimenStage}
                    {embed block table, caption: 'Where each drawer is kept', captionVisible: true}
                        {block tableHead}
                            <tr>
                                <th scope="col">Drawer</th>
                                <th scope="col">Room</th>
                            </tr>
                        {/block}

                        {block tableBody}
                            <tr>
                                <th scope="row">Head shields</th>
                                <td>The one with the window</td>
                            </tr>

                            <tr>
                                <th scope="row">Tail shields</th>
                                <td>The one without</td>
                            </tr>
                        {/block}
                    {/embed}
                {/block}
            {/embed}
        {/block}
    {/embed}

    {embed block sgSection, component: $components['c-swatch']}
        {block sgSectionBody}
            {embed block sgSpecimen, variant: 'default'}
                {block sgSpecimenStage}
                    {include swatch, name: '--color-accent', role: 'the action a page is about'}
                {/block}
            {/embed}
        {/block}
    {/embed}
{/block}
