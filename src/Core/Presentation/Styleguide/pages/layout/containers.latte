{templateType Trilobit\Core\Presentation\Styleguide\OverviewDefaultTemplate}

{*
 * The content column, its gutter, and the measure.
 *
 * The gutter has a heading and no section of its own: it is not a class but
 * the container's own padding (--layout-gutter), so the specimen of the
 * container is the specimen of the gutter too. How wide the column runs is not
 * decided here either - it is the content width the reader chose, shown on the
 * page the link points at. See .ai/plans/13-styleguide-layout.md, parts 2 and 4.
 *
 * The example content is invented and has to stay invented.
 *}

{import '../../templates/furniture.latte'}
{import '../../../components/notice.latte'}

{block sgPage}
    {embed block sgLayoutSection,
        primitive: 'l-container',
        summary: 'The content column: centred, as wide as the content width the reader chose and never wider '
            . 'than the room there is.'}
        {block sgLayoutSectionBody}
            <p class="l-measure">
                The column has no width of its own. It reads the content width - one of the three a theme
                declares, picked by the switch above - so everything meant to line up with it follows
                the same setting:
                <a n:href="page group: 'foundations', page: 'content-width'" data-testid="styleguide-content-width-link">see how the width is chosen</a>.
                The content of every page is drawn in one, this page included.
            </p>

            {embed block sgSpecimen, variant: 'the content column'}
                {block sgSpecimenStage}
                    <div class="l-container">
                        {include notice, message: 'Everything in the column starts one gutter in from its edges.'}
                    </div>
                {/block}
            {/embed}

            <h3>Gutter</h3>

            <p class="l-measure">
                The room between the edge of the column and what is in it, either side of the notice
                above. It is <code>--layout-gutter</code>, a token of the theme, and the container's own
                padding rather than a class or a gap between columns, so it goes wherever the container
                goes and is never set on its own.
            </p>
        {/block}
    {/embed}

    {embed block sgLayoutSection,
        primitive: 'l-measure',
        summary: 'A column narrow enough to read: running text stops at the measure, however wide the '
            . 'content around it runs.'}
        {block sgLayoutSectionBody}
            {embed block sgSpecimen, variant: 'running text at the measure'}
                {block sgSpecimenStage}
                    <p class="l-measure">
                        A line that runs the whole width of a wide screen is a line the eye loses on its
                        way back to the start of the next one. The measure is a token of the theme, so
                        where text stops is a decision the theme makes once, and a paragraph kept to it
                        reads the same whether the content around it runs at the narrowest width a reader
                        can choose or at the full width of the window.
                    </p>
                {/block}
            {/embed}
        {/block}
    {/embed}
{/block}
