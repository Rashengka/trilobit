{templateType Trilobit\Core\Presentation\Styleguide\OverviewDefaultTemplate}

{*
 * One thing a form asks for, with a line of text, with a control that is not
 * one, and with the two sentences that may go under a control. The controls
 * themselves, in every state, are on the pages of the Forms group.
 *
 * The example content is invented and has to stay invented.
 *}

{import '../../templates/furniture.latte'}
{import '../../../components/field.latte'}

{block sgPage}
    {embed block sgSection, component: $components['c-field']}
        {block sgSectionBody}
            {embed block sgSpecimen, variant: 'default'}
                {block sgSpecimenStage}
                    {embed block field}
                        {block fieldLabel}<label for="sg-field-town">Town</label>{/block}

                        {block fieldControl}
                            <input id="sg-field-town" type="text" value="Barrandov">
                        {/block}
                    {/embed}
                {/block}
            {/embed}

            {embed block sgSpecimen, variant: 'with a control that is not a line of text'}
                {block sgSpecimenStage}
                    {embed block field}
                        {block fieldLabel}<label for="sg-field-period">Period</label>{/block}

                        {block fieldControl}
                            <select id="sg-field-period">
                                <option>Cambrian</option>
                                <option>Ordovician</option>
                                <option>Silurian</option>
                            </select>
                        {/block}
                    {/embed}
                {/block}
            {/embed}

            {embed block sgSpecimen, variant: 'with a reason and a hint'}
                {block sgSpecimenStage}
                    {embed block field, errorId: 'sg-field-drawer-error', hintId: 'sg-field-drawer-hint'}
                        {block fieldLabel}<label for="sg-field-drawer">Drawer</label>{/block}

                        {block fieldControl}
                            <input
                                id="sg-field-drawer"
                                type="text"
                                value="Z-99"
                                aria-invalid="true"
                                aria-describedby="sg-field-drawer-error sg-field-drawer-hint"
                            >
                        {/block}

                        {block fieldError}No drawer in the cabinet is numbered that.{/block}

                        {block fieldHint}As it is written on the front of the drawer.{/block}
                    {/embed}
                {/block}
            {/embed}
        {/block}
    {/embed}
{/block}
