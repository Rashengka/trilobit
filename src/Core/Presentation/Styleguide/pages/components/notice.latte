{templateType Trilobit\Core\Presentation\Styleguide\OverviewDefaultTemplate}

{* One sentence a page has to say, as information and as a refusal. *}

{import '../../templates/furniture.latte'}
{import '../../../components/notice.latte'}

{block sgPage}
    {embed block sgSection, component: $components['c-notice']}
        {block sgSectionBody}
            {specimen 'info'}
                {include notice, message: 'The catalogue was saved.'}
            {/specimen}

            {specimen 'danger'}
                {include notice, message: 'The address or the password is not right.', variant: 'danger'}
            {/specimen}
        {/block}
    {/embed}
{/block}
