{templateType Trilobit\Core\Presentation\Styleguide\OverviewDefaultTemplate}

{*
 * The menu is drawn closed, as it is in the banner; the button opens it. What
 * the administration puts between who they are and the ways out is the
 * preference switch, which is not repeated here - the switch at the top of
 * this page is the one the guide carries on every page, and a second would put
 * two controls for every answer on one page.
 *
 * The example content is invented and has to stay invented.
 *}

{import '../../templates/furniture.latte'}
{import '../../../components/user-menu.latte'}

{block sgPage}
    {embed block sgSection, component: $components['c-user-menu']}
        {block sgSectionBody}
            {embed block sgSpecimen, variant: 'default'}
                {block sgSpecimenStage}
                    {embed block userMenu,
                        id: 'sg-user-menu-panel',
                        name: 'Pia Paradoxides',
                        email: 'pia@example.com',
                        signOutUrl: '#',
                        publicSiteUrl: '#'}
                        {block userMenuBody}
                            <p class="text-sm text-ink-muted">Whatever the page offers the person it belongs to.</p>
                        {/block}
                    {/embed}
                {/block}
            {/embed}
        {/block}
    {/embed}
{/block}
