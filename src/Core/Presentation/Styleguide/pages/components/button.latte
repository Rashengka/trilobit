{templateType Trilobit\Core\Presentation\Styleguide\OverviewDefaultTemplate}

{*
 * The one thing a page wants you to do, the quieter things beside it, and a
 * button that goes nowhere because it does something where it is.
 *}

{import '../../templates/furniture.latte'}
{import '../../../components/button.latte'}

{block sgPage}
    {embed block sgSection, component: $components['c-button']}
        {block sgSectionBody}
            {specimen 'primary'}
                {include button, label: 'Add to basket', href: '#'}
            {/specimen}

            {specimen 'quiet'}
                {include button, label: 'Keep looking', href: '#', variant: 'quiet'}
            {/specimen}

            {specimen 'without a destination'}
                {include button, label: 'Recalculate'}
            {/specimen}

            {specimen 'with an icon'}
                {include button, label: 'Sign out', href: '#', variant: 'quiet', icon: 'sign-out'}
            {/specimen}
        {/block}
    {/embed}
{/block}
