#
# What the Shop module adds to the configuration.
#
# The boot loads this file only when the module is switched on, so everything
# in it is absent from a build without the module - including the presenter
# mapping below, which is why a link into a switched-off module fails loudly
# instead of resolving to a blank page.
#

application:
    # Both halves are needed and both are absent from a build without this
    # module: the scan is how its presenters become services at all, and the
    # mapping is how a presenter name is turned into one of them.
    scanDirs:
        - %rootDir%/src/Shop/Presentation

    mapping:
        Shop: Trilobit\Shop\Presentation\*\*Presenter

#
# The data layer of this module, contributed the same way its presenters are:
# from a file the boot loads only when the module is switched on. A build
# without it therefore has no mapping for its entities and no directory of its
# migrations, so neither the schema tools nor the migration runner know its
# tables exist - which is what leaves them untouched in a database that still
# has them.
#
nettrine.orm:
    managers:
        default:
            mapping:
                Shop:
                    directories: [%rootDir%/src/Shop/Domain]
                    namespace: Trilobit\Shop\Domain

nettrine.migrations:
    directories:
        'Trilobit\Shop\Migrations': %rootDir%/src/Shop/Migrations
