{templateType Trilobit\Shop\Presentation\Admin\ProductsTemplate}

{*
 * One product, written.
 *
 * The form is drawn by the design system's vertical arrangement
 * (Trilobit\Core\Presentation\Form\FormFactory::createVertical()), so every
 * field, its hint and whatever was refused about it come out of c-field the
 * way they do on every other generated form. The price and the rate are drawn
 * for everybody and written in only by somebody who may change prices; the
 * form says so under each of them.
 *
 * Where the product answers is drawn beside the form for a product that has
 * been saved: every address, the permalink marked - the addresses are rows of
 * Core's register, and this is the one place in the administration they are
 * all shown together.
 *
 * So are its pictures, each from its published variants with the button that
 * takes it off, and the form a new one is added in. A request the server threw
 * away for its size is said at the top, because otherwise the page would be
 * drawn as if nothing had been sent (Trilobit\Core\Media\UploadLimit).
 *}

{import '../../../../../Core/Presentation/components/page-heading.latte'}
{import '../../../../../Core/Presentation/components/panel.latte'}
{import '../../../../../Core/Presentation/components/button.latte'}
{import '../../../../../Core/Presentation/components/badge.latte'}
{import '../../../../../Core/Presentation/components/notice.latte'}

{block content}
    {include pageHeading,
        title: $headline,
        lead: $lead,
        testId: 'shop-product-headline',
        leadTestId: 'shop-product-lead'}

    <div class="l-cluster">
        {include button, label: 'All products', href: $listUrl, variant: 'quiet', testId: 'shop-product-back'}
    </div>

    {if $bodyDropped}
        {include notice,
            message: 'What was sent was larger than this server takes at once, so none of it arrived and nothing was saved. A picture may have at most ' . $largestFile . '.',
            variant: 'danger',
            testId: 'shop-product-body-dropped'}
    {/if}

    {if $noCategory}
        {include notice,
            message: 'There is no category to file a product in yet. A product is filed in at least one, and categories are arranged by somebody who arranges the content of the site.',
            testId: 'shop-product-no-category'}
    {/if}

    {embed block panel, testId: 'shop-product-panel'}
        {block panelTitle}The product{/block}

        {block panelBody}
            {control product}
        {/block}
    {/embed}

    {if !$isNew}
        {embed block panel, testId: 'shop-product-pictures'}
            {block panelTitle}Pictures{/block}

            {block panelBody}
                <div class="l-stack">
                    <p n:if="$pictures === []" data-testid="shop-product-no-pictures">This product has no picture yet.</p>

                    <div n:if="$pictures !== []" class="l-cluster">
                        <figure n:foreach="$pictures as $picture" class="l-stack" data-testid="shop-product-picture-{$picture->id}">
                            <img
                                src="{$picture->src}"
                                srcset="{$picture->srcset}"
                                sizes="{$picture->width}px"
                                width="{$picture->width}"
                                height="{$picture->height}"
                                alt="{$picture->alt}"
                                loading="lazy"
                                data-testid="shop-product-picture-image-{$picture->id}">

                            <figcaption>{$picture->alt !== '' ? $picture->alt : $picture->name}</figcaption>

                            {* Taking it off removes the binding; the file stays in the library until plan 16. *}
                            {control $picture->remover()}
                        </figure>
                    </div>

                    {control pictures}
                </div>
            {/block}
        {/embed}

        {embed block panel, testId: 'shop-product-where'}
            {block panelTitle}Where it answers, and what it costs with tax{/block}

            {block panelBody}
                <div class="l-stack">
                    <p>With tax it costs <strong data-testid="shop-product-gross">{$priceWithVat}</strong>.</p>

                    <div class="l-cluster">
                        {foreach $addresses as $address}
                            {include badge,
                                label: '/' . $address->path . ($address->isCanonical() ? ' (permalink)' : ''),
                                variant: $address->isCanonical() ? 'accent' : 'plain',
                                testId: 'shop-product-address'}
                        {/foreach}
                    </div>
                </div>
            {/block}
        {/embed}
    {/if}
{/block}
