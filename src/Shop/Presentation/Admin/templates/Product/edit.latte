{templateType Trilobit\Shop\Presentation\Admin\ProductsTemplate}

{*
 * One product, written.
 *
 * The form is drawn by the design system's vertical arrangement
 * (Trilobit\Core\Presentation\Form\FormFactory::createVertical()), so every
 * field, its hint and whatever was refused about it come out of c-field the
 * way they do on every other generated form. The price and the rate are drawn
 * for everybody and written in only by somebody who may change prices; the
 * form says so under each of them.
 *
 * Where the product answers is drawn beside the form for a product that has
 * been saved: every address, the permalink marked - the addresses are rows of
 * Core's register, and this is the one place in the administration they are
 * all shown together.
 *
 * So are its pictures, a c-lightbox in the order they are shown in - each
 * opening over the page, the first one marked as the one the list of products
 * shows - and under each what it shows, written in, the buttons moving it a
 * place earlier or later and the button taking it off; then, in a panel of its
 * own, the form a new one is added in. A request the server threw away for its size is said at
 * the top, because otherwise the page would be drawn as if nothing had been
 * sent (Trilobit\Core\Media\UploadLimit).
 *}

{import '../../../../../Core/Presentation/components/page-heading.latte'}
{import '../../../../../Core/Presentation/components/panel.latte'}
{import '../../../../../Core/Presentation/components/button.latte'}
{import '../../../../../Core/Presentation/components/badge.latte'}
{import '../../../../../Core/Presentation/components/notice.latte'}
{import '../../../../../Core/Presentation/components/lightbox.latte'}

{block content}
    {include pageHeading,
        title: $headline,
        lead: $lead,
        testId: 'shop-product-headline',
        leadTestId: 'shop-product-lead'}

    <div class="l-cluster">
        {include button, label: 'All products', href: $listUrl, variant: 'quiet', testId: 'shop-product-back'}
    </div>

    {if $bodyDropped}
        {include notice,
            message: 'What was sent was larger than this server takes at once, so none of it arrived and nothing was saved. A picture may have at most ' . $largestFile . '.',
            variant: 'danger',
            testId: 'shop-product-body-dropped'}
    {/if}

    {if $noCategory}
        {include notice,
            message: 'There is no category to file a product in yet. A product is filed in at least one, and categories are arranged by somebody who arranges the content of the site.',
            testId: 'shop-product-no-category'}
    {/if}

    {embed block panel, testId: 'shop-product-panel'}
        {block panelTitle}The product{/block}

        {block panelBody}
            {control product}
        {/block}
    {/embed}

    {if !$isNew}
        {embed block panel, testId: 'shop-product-pictures'}
            {block panelTitle}Pictures{/block}

            {block panelBody}
                <div class="l-stack">
                    <p n:if="$pictures === []" data-testid="shop-product-no-pictures">This product has no picture yet.</p>

                    {if $pictures !== []}
                        <p class="text-sm text-ink-muted" data-testid="shop-product-pictures-order">The first picture is the one shown for the product in the list. Choose a picture to see it larger.</p>

                        {embed block lightbox,
                            id: Trilobit\Shop\Presentation\Admin\ProductPresenter::GALLERY,
                            label: 'Pictures of this product, in the order they are shown in',
                            pictures: $pictures,
                            testId: 'shop-product-gallery'}
                            {block lightboxItem}
                                <div class="l-stack" data-testid="shop-product-picture-{$picture->key}">
                                    {* Every place is a badge, so the first - marked besides as the
                                       one the list shows - stands in line with the others. *}
                                    <div class="l-cluster">
                                        {include badge, label: 'Picture ' . $position, testId: 'shop-product-picture-place-' . $picture->key}
                                        {if $position === 1}
                                            {include badge, label: 'Shown in the list', variant: 'accent', testId: 'shop-product-picture-main'}
                                        {/if}
                                    </div>

                                    {control "describePicture-{$picture->key}"}

                                    {* Nowhere to move a single picture, so no way to move it, as the
                                       lightbox offers no way from it to another. *}
                                    {if count($pictures) > 1}
                                        {control "movePicture-{$picture->key}"}
                                    {/if}

                                    {* Taking it off removes the binding; the file stays in the library
                                       until plan 16. On a line of its own, wherever the others end. *}
                                    <div>{control "removePicture-{$picture->key}"}</div>
                                </div>
                            {/block}
                        {/embed}
                    {/if}
                </div>
            {/block}
        {/embed}

        {* A panel of its own, so that what a new picture shows is not taken
           for what the last picture above it shows. *}
        {embed block panel, testId: 'shop-product-add-picture'}
            {block panelTitle}<span data-testid="shop-product-new-picture">Add a picture</span>{/block}

            {block panelBody}
                {control pictures}
            {/block}
        {/embed}

        {embed block panel, testId: 'shop-product-where'}
            {block panelTitle}Where it answers, and what it costs with tax{/block}

            {block panelBody}
                <div class="l-stack">
                    <p>With tax it costs <strong data-testid="shop-product-gross">{$priceWithVat}</strong>.</p>

                    <div class="l-cluster">
                        {foreach $addresses as $address}
                            {include badge,
                                label: '/' . $address->path . ($address->isCanonical() ? ' (permalink)' : ''),
                                variant: $address->isCanonical() ? 'accent' : 'plain',
                                testId: 'shop-product-address'}
                        {/foreach}
                    </div>
                </div>
            {/block}
        {/embed}
    {/if}
{/block}
