{templateType Trilobit\Crm\Presentation\Front\StatusDefaultTemplate}

{*
 * Scaffolding, and drawn out of the same components every other page is drawn
 * out of: the point of a page that says nothing is to prove that the shared
 * chrome, the presenter mapping and the template lookup all work for a module
 * that is switched on. Its appearance follows the theme like everything else,
 * so it costs nothing to keep once the module has real pages.
 *}

{import '../../../../../Core/Presentation/components/badge.latte'}
{import '../../../../../Core/Presentation/components/page-heading.latte'}
{import '../../../../../Core/Presentation/components/button.latte'}

{block content}
    <div class="l-stack">
        {include badge, label: $moduleName, variant: 'accent', testId: 'module-status-name'}

        {include pageHeading,
            title: $moduleName . ' is part of this build',
            lead: $summary,
            testId: 'module-status-headline',
            leadTestId: 'module-status-summary'}
    </div>

    <div class="l-cluster">
        {include button,
            label: 'Back to the homepage',
            href: $homeUrl,
            variant: 'quiet',
            testId: 'module-status-home-link'}
    </div>
{/block}
