{templateType Trilobit\Cms\Presentation\Admin\PagesTemplate}

{*
 * One page, written.
 *
 * The form is written out with n:name rather than handed to the framework's
 * default renderer, so that every control sits inside the design system's own
 * components - a renderer producing its own table of labels and inputs would
 * be a second way of drawing a form, unthemed and untested. It is the same
 * arrangement the sign-in page uses.
 *
 * Where the page answers is asked as two things: the category it is filed
 * under, chosen from the ones there are, and the last part of the address,
 * written. A whole address is never typed here - a deeper one typed by hand is
 * a row whose parents do not exist. The button beside the last part asks the
 * register for one made of the title; the rules it is made by are the
 * register's, and the script only carries the question and the answer (see
 * assets/segment-suggestion.ts).
 *
 * Whatever the register refused - the address is taken, it begins with
 * something reserved, the last part holds a slash or a dot - arrives as a list
 * of sentences the presenter read off the form, so this page is handed strings
 * rather than a component to interrogate.
 *}

{import '../../../../../Core/Presentation/components/page-heading.latte'}
{import '../../../../../Core/Presentation/components/panel.latte'}
{import '../../../../../Core/Presentation/components/button.latte'}
{import '../../../../../Core/Presentation/components/field.latte'}
{import '../../../../../Core/Presentation/components/notice.latte'}

{block content}
    {include pageHeading,
        title: $headline,
        lead: $lead,
        testId: 'cms-page-headline',
        leadTestId: 'cms-page-lead'}

    <div class="l-cluster">
        {include button, label: 'All pages', href: $listUrl, variant: 'quiet', testId: 'cms-page-back'}

        {if $publicUrl !== ''}
            {include button,
                label: 'Open it on the site',
                href: $publicUrl,
                variant: 'quiet',
                testId: 'cms-page-public'}
        {/if}
    </div>

    {embed block panel, testId: 'cms-page-panel'}
        {block panelTitle}The page{/block}

        {block panelBody}
            <form n:name="page" class="l-stack" data-testid="cms-page-form">
                {foreach $errors as $error}
                    {include notice, message: $error, variant: 'danger', testId: 'cms-page-error'}
                {/foreach}

                {if $typedAddress !== ''}
                    {include notice,
                        message: 'This page answers at ' . $typedAddress . ', an address typed out in full before categories existed. It stays there until the category or the last part below is changed; then it moves, and the old address keeps leading to the new one.',
                        testId: 'cms-page-legacy-address'}
                {/if}

                {embed block field, testId: 'cms-page-title-field'}
                    {block fieldLabel}<label n:name="title">Title</label>{/block}

                    {block fieldControl}
                        <input n:name="title" data-testid="cms-page-title-input">
                    {/block}
                {/embed}

                {embed block field, testId: 'cms-page-category-field', hintId: 'cms-page-category-hint'}
                    {block fieldLabel}<label n:name="category">Category</label>{/block}

                    {block fieldControl}
                        <select n:name="category" data-combobox aria-describedby="cms-page-category-hint" data-testid="cms-page-category-input"></select>
                    {/block}

                    {block fieldHint}What the page is filed under. Its address begins with the category's.{/block}
                {/embed}

                {embed block field, testId: 'cms-page-segment-field', hintId: 'cms-page-segment-hint'}
                    {block fieldLabel}<label n:name="segment">Last part of the address</label>{/block}

                    {block fieldControl}
                        <div class="l-cluster">
                            <input n:name="segment" aria-describedby="cms-page-segment-hint" data-testid="cms-page-segment-input">

                            {include button,
                                label: 'Suggest from the title',
                                variant: 'quiet',
                                testId: 'cms-page-suggest',
                                attributes: [
                                    'data-suggest-segment' => $suggestUrl,
                                    'data-suggest-from' => 'title',
                                    'data-suggest-under' => 'category',
                                    'data-suggest-into' => 'segment',
                                ]}

                            <output data-suggest-status aria-live="polite" data-testid="cms-page-suggest-status"></output>
                        </div>
                    {/block}

                    {block fieldHint}Lower case letters, digits and hyphens - no slash and no dot.{/block}
                {/embed}

                {embed block field, testId: 'cms-page-state-field'}
                    {block fieldLabel}<label n:name="status">State</label>{/block}

                    {block fieldControl}
                        <select n:name="status" data-testid="cms-page-status-input"></select>
                    {/block}
                {/embed}

                {embed block field, testId: 'cms-page-lead-field'}
                    {block fieldLabel}<label n:name="perex">Lead</label>{/block}

                    {block fieldControl}
                        <textarea n:name="perex" rows="3" data-testid="cms-page-perex-input"></textarea>
                    {/block}
                {/embed}

                {embed block field, testId: 'cms-page-body-field'}
                    {block fieldLabel}<label n:name="content">Body</label>{/block}

                    {block fieldControl}
                        <textarea n:name="content" rows="12" data-testid="cms-page-content-input"></textarea>
                    {/block}
                {/embed}

                {embed block field, testId: 'cms-page-seo-title-field'}
                    {block fieldLabel}<label n:name="seoTitle">Title for search engines</label>{/block}

                    {block fieldControl}
                        <input n:name="seoTitle" data-testid="cms-page-seo-title-input">
                    {/block}
                {/embed}

                {embed block field, testId: 'cms-page-seo-description-field'}
                    {block fieldLabel}<label n:name="seoDescription">Description for search engines</label>{/block}

                    {block fieldControl}
                        <input n:name="seoDescription" data-testid="cms-page-seo-description-input">
                    {/block}
                {/embed}

                {* The controls of a form have to be the form's own elements -
                   n:name is resolved on the element itself - and c-button
                   draws an element of its own, so these carry the component's
                   class instead of being drawn by it. *}
                <div class="l-cluster">
                    <button n:name="send" class="c-button" data-testid="cms-page-save">Save</button>

                    {if !$isNew}
                        <button n:name="delete" class="c-button c-button--danger" data-testid="cms-page-delete">Delete this page</button>
                    {/if}
                </div>
            </form>
        {/block}
    {/embed}
{/block}
